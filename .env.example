# Puerto del servidor (Render lo asigna automáticamente en producción)
PORT=3000

# development | production
NODE_ENV=development

# Conexión a MongoDB.
# Local: mongodb://127.0.0.1:27017/NOMBRE_BASE
MONGODB_URI=mongodb://127.0.0.1:27017/backend_tp2
# Atlas: mongodb+srv://USUARIO:CONTRASENA@CLUSTER.mongodb.net/NOMBRE_BASE?retryWrites=true&w=majority

# Autenticación con JWT
# Generar una clave segura: openssl rand -base64 32
JWT_SECRET=cambiar_por_clave_segura_en_produccion
JWT_EXPIRES_IN=1h
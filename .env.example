# Puerto del servidor (Render lo asigna automáticamente en producción)
PORT=3000

# development | production
NODE_ENV=development

# Conexión a MongoDB. Incluir siempre el nombre de la base antes del "?".
# Desarrollo: base urbana_cult_dev. La base urbana_cult es la de producción (Render).
# Local: mongodb://127.0.0.1:27017/urbana_cult_dev
# Atlas: mongodb+srv://USUARIO:CONTRASENA@CLUSTER.mongodb.net/urbana_cult_dev?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/urbana_cult_dev

# Base local para npm run seed:local (opcional; por defecto mongodb://127.0.0.1:27017/urbana_cult_dev)
# MONGODB_URI_LOCAL=mongodb://127.0.0.1:27017/urbana_cult_dev
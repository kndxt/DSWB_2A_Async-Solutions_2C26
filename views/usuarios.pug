extends layout

block content
  h1 Usuarios

  //- Mensajes de éxito y error (include compartido de F5.1)
  include includes/mensajes

  //- Estilos propios de esta página para distinguir los usuarios inactivos.
  style.
    .usuario-inactivo td { color: #6b7280; background: #f3f4f6; }
    .estado { display: inline-block; padding: 0.1rem 0.5rem; border-radius: 999px; font-size: 0.85rem; font-weight: 600; }
    .estado-activo { background: #dcfce7; color: #166534; }
    .estado-inactivo { background: #e5e7eb; color: #374151; }

  section.acciones
    button#btn-nuevo-usuario(type="button") Nuevo usuario

  section#listado-usuarios
    h2 Listado de usuarios
    table#tabla-usuarios
      thead
        tr
          th Nombre
          th Email
          th Teléfono
          th Estado
          th Acciones
      tbody#usuarios-body
        tr
          td(colspan="5") Cargando usuarios...

  section#detalle-usuario(hidden)
    h2 Detalle del usuario
    div#detalle-datos
    button#btn-cerrar-detalle(type="button") Cerrar

  section#formulario-usuario(hidden)
    h2#titulo-formulario Nuevo usuario
    //- novalidate y sin required en los inputs: las validaciones de negocio las hace
    //- el backend y sus mensajes son los que se muestran.
    form#form-usuario(novalidate)
      input#usuario-id(type="hidden" name="id")

      fieldset
        legend Datos del usuario
        div.campo
          label(for="nombre") Nombre
          input#nombre(type="text" name="nombre" autocomplete="off")
        div.campo
          label(for="apellido") Apellido
          input#apellido(type="text" name="apellido" autocomplete="off")
        div.campo
          label(for="email") Email
          input#email(type="text" name="email" autocomplete="off")
        div.campo
          label(for="telefono") Teléfono
          input#telefono(type="text" name="telefono" autocomplete="off")
        div.campo
          label(for="password") Contraseña
          input#password(type="password" name="password" autocomplete="new-password")
          small En edición, dejala vacía para no cambiarla.

      div.botones
        button#btn-guardar(type="submit") Guardar
        button#btn-cancelar(type="button") Cancelar

block scripts
  script(type="module" src="/js/usuarios.js")
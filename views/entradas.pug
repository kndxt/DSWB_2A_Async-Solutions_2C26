
extends layout

include mixins/tabla.pug

block title
  | Entradas del evento | Urbana Cult

block content
    h1 Entradas del evento ##{eventoId}

    .resumen
      p
        strong Evento:
        |  #{evento.nombre}
      p
        strong Sala:
        |  #{sala.nombre} (capacidad: #{sala.capacidad})
      p
        strong Entradas vendidas:
        |  #{vendidas.length}
      p
        strong Entradas disponibles:
        |  #{disponibles}

    h2 Entradas vendidas

    if vendidas.length === 0
      p.vacio No hay entradas vendidas para este evento.
    else
      -
        const columnas = ["ID", "Usuario ID", "Estado", "Fecha de venta"]

        const filas = vendidas.map(entrada => [
          entrada.id,
          entrada.usuarioId,
          entrada.estado,
          entrada.fechaVenta
        ])
      +tabla(columnas, filas)
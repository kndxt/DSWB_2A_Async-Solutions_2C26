
extends layout

block title
  | Iniciar sesión | Urbana Cult

block content
  h1 Iniciar sesión

  section#formulario-login
    p Ingresá tu email y contraseña para continuar.

    div#mensaje-login(aria-live="polite")
      include includes/mensajes

    form#form-login
      div.campo
        label(for="email") Email
        input#email(
          type="email"
          name="email"
          autocomplete="username"
          required
        )

      div.campo
        label(for="password") Contraseña
        input#password(
          type="password"
          name="password"
          autocomplete="current-password"
          required
        )

      div.botones
        button#btn-login(type="submit") Iniciar sesión

      p
        a(href="/vistas/inicio") Volver al inicio

block scripts
  script(type="module" src="/js/login.js")

extends ../layout
include ../mixins/tabla.pug

block title
  | Entradas — Urbana Cult

block estilos
  link(rel="stylesheet" href="/css/entradas.css")

block content

  h1= esAdmin ? "Administración de entradas" : "Mis entradas"

  //- Cualquier usuario con sesión compra entradas a su propio nombre.
  section
    h2 Comprar una entrada

    form#form-compra(novalidate)
      .campo
        label(for="eventoId") Evento
        select#eventoId(name="eventoId")
          option(value="") Cargando eventos...

      button#boton-comprar(type="submit") Comprar entrada

  section
    h2= esAdmin ? "Entradas registradas" : "Mis entradas compradas"
    p#estado(aria-live="polite") Cargando entradas...
    +tabla([], undefined, "tabla-entradas")

block scripts
  script(type="module" src="/js/pages/entradas.js")

extends ../layout
include ../mixins/tabla.pug

block title
  | Entradas | Urbana Cult

block content
  if usuario && usuario.rol === "admin"
    h1 Administración de entradas
  else
    h1 Mis entradas

  section#mensajes(aria-live="polite")

  section
    h2 Vender una entrada

    form#form-venta
      div
        label(for="eventoId") Evento
        select#eventoId(name="eventoId" required)
          option(value="") Cargando eventos...

      button#boton-vender(type="submit") Vender entrada

  section
    if usuario && usuario.rol === "admin"
      h2 Entradas registradas
    else
      h2 Mis entradas compradas

    p#estado Cargando entradas...

    +tabla([], [], "tabla-entradas")

block scripts
  script(type="module" src="/js/pages/entradas.js")

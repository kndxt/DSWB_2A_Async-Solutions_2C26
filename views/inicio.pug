extends layout

block title
  | Inicio | Urbana Cult

block estilos
  link(rel="stylesheet" href="/css/chat.css")

block content
  if usuario
    section.inicio.inicio--usuario
      h1 Te damos la bienvenida a Urbana Cult
      p.inicio__texto
        | Hola, #{usuario.nombre}. Compartí mensajes con la comunidad y consultale al asistente con
        |
        strong @gemini
        | .

    include includes/chat.pug
  else
    section.inicio.inicio--visitante
      h1 Te damos la bienvenida a Urbana Cult
      p.inicio__texto
        | La plataforma de gestión de espacios culturales independientes: eventos,
        | salas, reservas y entradas en un solo lugar.
      p.inicio__texto
        | Iniciá sesión o creá tu cuenta para participar de la comunidad.

      div.botones
        a.boton(href="/vistas/login") Iniciar sesión
        a.boton.boton-secundario(href="/vistas/registro") Registrarse

block scripts
  if usuario
    script(src="/socket.io/socket.io.js")
    script(type="module" src="/js/chat.js")

//- Disponible en todas las vistas: true si quien navega es administrador.
- var esAdmin = usuario && usuario.rol === "admin"

doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title
      block title
        | Urbana Cult
    include includes/estilos.pug
    block estilos

  body(data-rol=usuario ? usuario.rol : "" data-usuario-id=usuario ? usuario.id : "")
    header
      include includes/navbar.pug

    main
      include includes/mensajes.pug
      block content

    block scripts
    script(type="module" src="/js/core/sesion.js")

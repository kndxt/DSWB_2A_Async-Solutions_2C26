//- Módulos del sistema, según el rol del usuario. Sin rol (sin sesión) no se muestra ninguno.
mixin enlacesModulos(rol)
  -
    const modulos = [
      { texto: "Usuarios", href: "/vistas/usuarios", roles: ["admin"] },
      { texto: "Salas", href: "/vistas/salas", roles: ["admin", "cliente"] },
      { texto: "Eventos", href: "/vistas/eventos", roles: ["admin", "cliente"] },
      { texto: "Reservas", href: "/vistas/reservas", roles: ["admin", "cliente"] },
      { texto: "Entradas", href: "/vistas/entradas", roles: ["admin", "cliente"] },
    ]
  each modulo in modulos
    if rol && modulo.roles.includes(rol)
      li
        a(href=modulo.href)= modulo.texto


extends layout
include mixins/tabla.pug

block title
  | Eventos próximos | Urbana Cult

block content
  h1 Eventos próximos

  if eventos.length === 0
    p.vacio No hay eventos próximos.
  else
    -
      const columnas = [
        "ID", "Nombre", "Tipo", "Fecha inicio",
        "Fecha fin", "Precio", "Estado", "Sala"
      ]

      const filas = eventos.map(evento => [
        evento.id,
        evento.nombre,
        evento.tipo,
        evento.fechaInicio,
        evento.fechaFin,
        "$" + evento.precioEntrada,
        evento.estado,
        evento.salaId
      ])

    +tabla(columnas, filas)